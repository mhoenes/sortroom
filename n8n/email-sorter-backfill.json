{
  "name": "E-Mail-Sorter – Backfill (manuell)",
  "nodes": [
    {
      "parameters": {},
      "id": "7c1f9e1b-2d3e-4f5a-8b20-000000000001",
      "name": "Backfill starten",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "7c1f9e1b-2d3e-4f5a-8b20-0000000000a1",
              "name": "since",
              "value": "2024-01-01",
              "type": "string"
            },
            {
              "id": "7c1f9e1b-2d3e-4f5a-8b20-0000000000a2",
              "name": "live",
              "value": false,
              "type": "boolean"
            },
            {
              "id": "7c1f9e1b-2d3e-4f5a-8b20-0000000000a3",
              "name": "limit",
              "value": 0,
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "7c1f9e1b-2d3e-4f5a-8b20-000000000002",
      "name": "Parameter",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0],
      "notes": "since = Startdatum (YYYY-MM-DD). live = false: nur Probelauf mit CSV-Bericht. limit = 0: kein Limit."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://email-sorter:8765/backfill",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ since: $json.since, live: $json.live, limit: $json.limit > 0 ? $json.limit : null }) }}",
        "options": {}
      },
      "id": "7c1f9e1b-2d3e-4f5a-8b20-000000000003",
      "name": "Backfill anstoßen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "notes": "Antwortet sofort mit 202 und einer Job-ID; der Backfill läuft im Sorter-Container weiter."
    },
    {
      "parameters": {
        "amount": 1,
        "unit": "minutes"
      },
      "id": "7c1f9e1b-2d3e-4f5a-8b20-000000000004",
      "name": "1 Minute warten",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [660, 0],
      "webhookId": "7c1f9e1b-2d3e-4f5a-8b20-0000000000w1"
    },
    {
      "parameters": {
        "url": "=http://email-sorter:8765/jobs/{{ $('Backfill anstoßen').first().json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "7c1f9e1b-2d3e-4f5a-8b20-000000000005",
      "name": "Status abfragen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "7c1f9e1b-2d3e-4f5a-8b20-0000000000c1",
              "leftValue": "={{ $json.status }}",
              "rightValue": "running",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "7c1f9e1b-2d3e-4f5a-8b20-000000000006",
      "name": "Läuft noch?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1100, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "7c1f9e1b-2d3e-4f5a-8b20-0000000000b1",
              "name": "status",
              "value": "={{ $json.status }}",
              "type": "string"
            },
            {
              "id": "7c1f9e1b-2d3e-4f5a-8b20-0000000000b2",
              "name": "zusammenfassung",
              "value": "={{ $json.result ? `${$json.result.classified} Mails, ${$json.result.moved} verschoben, ${$json.result.kept_in_inbox} im Posteingang, ${$json.result.expired_tagged} abgelaufen, ${$json.result.failed} Fehler, $${$json.result.cost_usd}` : $json.error }}",
              "type": "string"
            },
            {
              "id": "7c1f9e1b-2d3e-4f5a-8b20-0000000000b3",
              "name": "ergebnis",
              "value": "={{ $json.result }}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "id": "7c1f9e1b-2d3e-4f5a-8b20-000000000007",
      "name": "Ergebnis",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1320, 100]
    }
  ],
  "connections": {
    "Backfill starten": {
      "main": [[{ "node": "Parameter", "type": "main", "index": 0 }]]
    },
    "Parameter": {
      "main": [[{ "node": "Backfill anstoßen", "type": "main", "index": 0 }]]
    },
    "Backfill anstoßen": {
      "main": [[{ "node": "1 Minute warten", "type": "main", "index": 0 }]]
    },
    "1 Minute warten": {
      "main": [[{ "node": "Status abfragen", "type": "main", "index": 0 }]]
    },
    "Status abfragen": {
      "main": [[{ "node": "Läuft noch?", "type": "main", "index": 0 }]]
    },
    "Läuft noch?": {
      "main": [
        [{ "node": "1 Minute warten", "type": "main", "index": 0 }],
        [{ "node": "Ergebnis", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}
