{
  "name": "E-Mail-Sorter – alle 10 Minuten",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 10
            }
          ]
        }
      },
      "id": "5b0e8f0a-1c2d-4e3f-9a10-000000000001",
      "name": "Alle 10 Minuten",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://email-sorter:8765/run",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"live\": true}",
        "options": {
          "timeout": 900000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "5b0e8f0a-1c2d-4e3f-9a10-000000000002",
      "name": "Sorter ausführen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 30000,
      "notes": "Credential: Header Auth, Name = Authorization, Value = Bearer <API_TOKEN aus der .env>"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "5b0e8f0a-1c2d-4e3f-9a10-0000000000c1",
              "leftValue": "={{ $json.statusCode !== 409 && !($json.statusCode === 200 && $json.body.ok === true) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "5b0e8f0a-1c2d-4e3f-9a10-000000000003",
      "name": "Fehler?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 0],
      "notes": "409 = ein anderer Lauf (z. B. Backfill) ist noch aktiv – kein Fehler."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "5b0e8f0a-1c2d-4e3f-9a10-0000000000a1",
              "name": "betreff",
              "value": "=E-Mail-Sorter: Lauf fehlgeschlagen (HTTP {{ $json.statusCode }})",
              "type": "string"
            },
            {
              "id": "5b0e8f0a-1c2d-4e3f-9a10-0000000000a2",
              "name": "details",
              "value": "={{ JSON.stringify($json.body, null, 2) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "5b0e8f0a-1c2d-4e3f-9a10-000000000004",
      "name": "Fehlermeldung bauen",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [720, -100],
      "notes": "Hier einen Benachrichtigungs-Node anhängen (E-Mail senden, Telegram, ntfy …) mit {{ $json.betreff }} und {{ $json.details }}."
    },
    {
      "parameters": {},
      "id": "5b0e8f0a-1c2d-4e3f-9a10-000000000005",
      "name": "OK",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [720, 100]
    }
  ],
  "connections": {
    "Alle 10 Minuten": {
      "main": [[{ "node": "Sorter ausführen", "type": "main", "index": 0 }]]
    },
    "Sorter ausführen": {
      "main": [[{ "node": "Fehler?", "type": "main", "index": 0 }]]
    },
    "Fehler?": {
      "main": [
        [{ "node": "Fehlermeldung bauen", "type": "main", "index": 0 }],
        [{ "node": "OK", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none"
  },
  "active": false
}
