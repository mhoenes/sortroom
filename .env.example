# Copy to .env and fill in. Never commit .env.

# Strato: full e-mail address and the mailbox password
IMAP_USER=you@your-domain.de
IMAP_PASSWORD=

# Jev gateway key (variable name = api_key_env in config.toml)
# OpenRouter: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Vercel AI Gateway: Vercel dashboard -> AI Gateway -> API Keys
AI_GATEWAY_API_KEY=

# --- Docker / n8n only ---------------------------------------------------
# Token n8n sends as "Authorization: Bearer <API_TOKEN>" (at least 16 characters).
# Generate one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
# Docker network of your n8n container (see docker-compose.yml)
N8N_NETWORK=n8n_default
