# Copy to .env and fill in. Never commit .env.
# The IMAP login of each mailbox and the API key of the classification endpoint are not set
# here but in the admin UI (Settings / Global settings; stored in secrets.toml files, see the wiki
# page "Mailboxes and files": https://github.com/mhoenes/sortroom/wiki/Mailboxes-and-files).

# Required: the admin UI login (at least 8 characters; the UI stays locked without it)
ADMIN_PASSWORD=

# Only needed to trigger runs from outside via the HTTP API ("Authorization: Bearer <API_TOKEN>",
# at least 16 characters). Generate one, e.g.: openssl rand -base64 32
API_TOKEN=

# --- Docker ----------------------------------------------------------------
# Optional: another image than ghcr.io/mhoenes/sortroom:latest (the latest release), e.g. a
# pinned version (ghcr.io/mhoenes/sortroom:0.13), :edge (the main branch), a fork or a local
# build (sortroom)
SORTROOM_IMAGE=
# Host port of the admin UI (default 8765)
#UI_PORT=8765
# Set to 1 when the UI is served over HTTPS (e.g. behind a reverse proxy)
#UI_SECURE_COOKIES=1
# Where the sidebar's "Source code" link points; set it to your own repository if you run a
# modified Sortroom for other people (AGPL-3.0)
#SOURCE_URL=https://github.com/mhoenes/sortroom
