# Copy to .env and fill in. Never commit .env.

# The IMAP login of each mailbox and the API key of the classification endpoint are best
# set in the admin UI (Settings / Global settings; stored in secrets.toml files, see README).
# These variables are only the fallback when nothing is stored there:
#IMAP_USER=you@your-domain.de
#IMAP_PASSWORD=
#CLASSIFIER_API_KEY=

# --- Docker ----------------------------------------------------------------
# Only needed to trigger runs from outside via the HTTP API ("Authorization: Bearer <API_TOKEN>",
# at least 16 characters). Generate one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=
# Optional: another image than ghcr.io/mhoenes/sortroom:latest, e.g. a pinned version
# (ghcr.io/mhoenes/sortroom:0.5), a fork or a local build (sortroom:latest)
SORTROOM_IMAGE=
# Admin UI login (at least 8 characters; the UI stays locked without it)
ADMIN_PASSWORD=
# Host port of the admin UI (default 8765)
#UI_PORT=8765
# Set to 1 when the UI is served over HTTPS (e.g. behind a reverse proxy)
#UI_SECURE_COOKIES=1
